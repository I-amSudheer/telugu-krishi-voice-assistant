# Server
PORT=3001
JSON_LIMIT=25mb

# Gnani API base settings
# IMPORTANT: Replace these with real values from your Gnani dashboard/docs.

# Speech to Text (Prisma)
GNANI_PRISMA_URL=https://api.vachana.ai/stt/v3
GNANI_PRISMA_KEY=YOUR_GNANI_API_KEY
GNANI_PRISMA_REQUEST_MODE=json

# LLM (Evon)
GNANI_EVON_URL=https://api.evon.ai/v1/chat/completions
GNANI_EVON_KEY=YOUR_GNANI_EVON_API_KEY

# How to call Evon API (unknown; try auto first)
GNANI_EVON_REQUEST_MODE=auto

# Used only when GNANI_EVON_REQUEST_MODE=chat_completions
GNANI_EVON_MODEL=evon

# Text to Speech (Timbre) — WebSocket
# Default endpoint used by code if you don't set GNANI_TIMBRE_URL
GNANI_TIMBRE_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TIMBRE_KEY=YOUR_TIMBRE_API_KEY

# Optional Timbre settings
GNANI_TIMBRE_VOICE=Kaveri
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_LANGUAGE=te-IN
GNANI_TIMBRE_SPEED=1.0
